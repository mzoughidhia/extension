rules_version = '2';

// Règles Storage — Phase 2.
//
// Posture générale : deny-by-default (voir le match générique en fin de fichier).
// Les documents d'un dossier vivent sous `quoteFiles/{quoteFileId}/documents/**` ;
// l'accès est scopé au courtier propriétaire du dossier Firestore correspondant
// (même contrôle `ownerUid` que `firestore.rules`).
service firebase.storage {
  match /b/{bucket}/o {
    match /quoteFiles/{quoteFileId}/documents/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid ==
           firestore.get(/databases/(default)/documents/quoteFiles/$(quoteFileId)).data.ownerUid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
